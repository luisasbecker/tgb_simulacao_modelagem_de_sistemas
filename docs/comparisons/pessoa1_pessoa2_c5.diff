+# Interrompe CHEGADAS aos 5400 s; atendimento continua ate RunDuration=9000 s.
+# ExpressionThreshold atua sobre o gerador, nao sobre os servidores.
+HorarioPico OpenCondition { 'this.SimTime < 5400[s]' }
+ChegadaClientes OperatingThresholdList { HorarioPico }
+
+# Avalia fila no instante de chegada: mais de cinco aguardando -> desiste.
+# Tipagem por CLIENTE (nao por sanduiche); campos podem ser copiados na
+# futura duplicacao de lanches feita pela Pessoa 3.
+DecisaoDesistencia NextComponentList { ClassificaPedido RegistroDesistencia }
+DecisaoDesistencia Choice { '[FilaBalcao].QueueLength > 5 ? 2 : 1' }
+RegistroDesistencia AttributeAssignmentList { '[ContadorDesistencias].TotalDesistencias = [ContadorDesistencias].TotalDesistencias + 1' }
+RegistroDesistencia NextComponent { SaidaDesistencia }
+ClassificaPedido AttributeAssignmentList { 'this.obj.TipoPedido = [TipoPedidoDist].Value' }
+ClassificaPedido NextComponent { SorteiaMontagem }
+SorteiaMontagem AttributeAssignmentList { 'this.obj.TempoMontagem = this.obj.TipoPedido == 1 ? [MontagemSimplesDist].Value : this.obj.TipoPedido == 2 ? [MontagemTradicionalDist].Value : [MontagemComplexoDist].Value' }
+SorteiaMontagem NextComponent { FilaBalcao }
