+# -------- Pessoa 2: atributos (1=simples, 2=tradicional, 3=complexo) -------
+Cliente AttributeDefinitionList { { TipoPedido 2 } { TempoMontagem 105 s } }
+ContadorDesistencias AttributeDefinitionList { { TotalDesistencias 0 } }
+
+TipoPedidoDist UnitType { DimensionlessUnit }
